# Template only. Replace empty values privately; never commit a populated .env.
# API + worker use the same APP_ORIGIN, SESSION_SECRET and ENCRYPTION_KEY.
NODE_ENV=production
HOST=0.0.0.0
PORT=3001
APP_ORIGIN=
# Public HTTPS API/container origin, used by scripts/configure-vercel.mjs only.
NOCTIS_BACKEND_ORIGIN=
# Distinct restricted roles. Supabase or Neon; copy endpoints from provider.
DATABASE_URL=
AUTH_DATABASE_URL=
WORKER_DATABASE_URL=
# Session/direct connection, NEVER transaction pooler.
LISTENER_DATABASE_URL=
# Put MIGRATION_DATABASE_URL in .env.migration only.
DATABASE_SSL=true
# Optional path to provider root CA, if required. Never set rejectUnauthorized=false.
DATABASE_CA=
API_POOL_SIZE=5
AUTH_POOL_SIZE=2
WORKER_POOL_SIZE=2
DB_CONNECT_TIMEOUT_MS=10000
REALTIME_CONCURRENCY=4
SESSION_SECRET=
ENCRYPTION_KEY=
STORAGE_DRIVER=r2
STORAGE_PATH=/var/lib/noctis/uploads
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Use the LiveKit Cloud HTTPS equivalent of the project URL from its dashboard.
LIVEKIT_INTERNAL_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
MAIL_TRANSPORT=smtp
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Leave disabled unless configured with authorized audio sources.
MUSIC_AUDIO_HOSTS=
FFMPEG_PATH=ffmpeg
# Do not use wildcard proxy trust; configure only after verifying ingress.
TRUST_PROXY_CIDR=
