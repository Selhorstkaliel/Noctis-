# Run npm run setup:local to generate private development credentials.
NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://noctis_api:REPLACE_ME@localhost:54329/noctis
AUTH_DATABASE_URL=postgresql://noctis_auth:REPLACE_ME@localhost:54329/noctis
WORKER_DATABASE_URL=postgresql://noctis_worker:REPLACE_ME@localhost:54329/noctis
MIGRATION_DATABASE_URL=postgresql://noctis_migrator:REPLACE_ME@localhost:54329/noctis
ADMIN_DATABASE_URL=postgresql://postgres:REPLACE_ME@localhost:54329/noctis
POSTGRES_PASSWORD=REPLACE_ME
SESSION_SECRET=REPLACE_WITH_64_HEX_CHARACTERS
ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTACTERS
STORAGE_PATH=REPLACE_WITH_ABSOLUTE_PATH_OUTSIDE_APP
DATABASE_SSL=false
SEED_DEMO=false
SEED_EMAIL=REPLACE_ME
SEED_PASSWORD=REPLACE_ME
# Provider callbacks: APP_ORIGIN/api/oauth/:provider/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
LIVEKIT_INTERNAL_URL=http://127.0.0.1:17880
LIVEKIT_API_KEY=REPLACE_WITH_RANDOM_API_KEY
LIVEKIT_API_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
MEDIA_PUBLIC_IP=REPLACE_WITH_THIS_MACHINE_IPV4
PUBLIC_HOST=localhost
# Exact hostnames that may provide direct, licensed audio files (comma separated).
MUSIC_AUDIO_HOSTS=
MUSIC_MAX_QUEUE=100
MUSIC_MAX_TRACK_SECONDS=3600
MUSIC_MAX_SOURCE_BYTES=209715200
MUSIC_FETCH_TIMEOUT_MS=10000
MUSIC_IDLE_DISCONNECT_SECONDS=300
FFMPEG_PATH=ffmpeg
MAIL_TRANSPORT=file
# Local messages are written by the worker to STORAGE_PATH/mail; never use file delivery in production.
# Railway Free/Trial/Hobby blocks SMTP. Use the MailerSend HTTPS API there.
MAIL_FROM=noctis@localhost.invalid
MAILERSEND_API_TOKEN=
SMTP_HOST=smtp.mailersend.net
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
