# Run coturn on a host reachable by participants. Substitute operator-managed values.
listening-port=3478
tls-listening-port=5349
fingerprint
use-auth-secret
static-auth-secret=REPLACE_WITH_TURN_SECRET
realm=REPLACE_WITH_PUBLIC_TURN_HOST
cert=/run/secrets/turn.crt
pkey=/run/secrets/turn.key
min-port=49160
max-port=49200
no-multicast-peers
no-loopback-peers
no-cli
no-tlsv1
no-tlsv1_1
stale-nonce=600
total-quota=200
bps-capacity=100000000
# Add denied-peer-ip entries for internal and metadata networks in your deployment.
