{
  "name": "noctis",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "security:preflight": "node --import tsx scripts/security-preflight.mjs",
    "test:restore": "node scripts/test-restore.mjs",
    "dev": "concurrently -k -n web,api,worker \"vite --host 127.0.0.1\" \"tsx watch server/index.ts\" \"tsx watch server/worker.ts\"",
    "build": "node scripts/build.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit && tsc -p server/tsconfig.json --noEmit",
    "test": "npm run test:api && npm run test:e2e",
    "format": "prettier --write src tests server/**/*.ts scripts/*.mjs *.json *.md index.html vite.config.ts playwright.config.ts",
    "format:check": "prettier --check src tests server/**/*.ts scripts/*.mjs *.json *.md index.html vite.config.ts playwright.config.ts",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "tsx watch server/index.ts",
    "dev:worker": "tsx watch server/worker.ts",
    "setup:local": "node scripts/setup-local.mjs && node scripts/setup-media.mjs",
    "setup:media": "node scripts/setup-media.mjs",
    "docker:setup": "node scripts/setup-docker-local.mjs",
    "docker:up": "npm run docker:setup && docker compose --env-file .env.docker -f compose.yaml -f compose.full.yaml up -d --build",
    "docker:down": "docker compose --env-file .env.docker -f compose.yaml -f compose.full.yaml down",
    "db:migrate": "tsx server/migrate.ts",
    "db:bootstrap": "tsx server/migrate.ts --bootstrap",
    "db:seed": "tsx server/seed.ts --demo",
    "start": "node build/server/server/index.js",
    "start:worker": "node build/server/server/worker.js",
    "test:setup": "node scripts/setup-test.mjs",
    "test:api": "node scripts/run-tests.mjs api",
    "test:e2e": "node scripts/run-tests.mjs",
    "audit:verify": "node scripts/verify-audit.mjs",
    "test:load": "node scripts/run-tests.mjs load",
    "test:replicas": "node scripts/test-replicas.mjs",
    "test:music-media": "node scripts/smoke-music-media.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.3.0",
    "@livekit/rtc-node": "1.0.0",
    "@node-rs/argon2": "^2.2.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.3",
    "livekit-client": "^2.22.3",
    "livekit-server-sdk": "^2.19.0",
    "lucide-react": "^0.468.0",
    "nodemailer": "^10.0.8",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sharp": "^0.35.4",
    "ws": "^8.21.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.0",
    "@types/node": "^26.5.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.5",
    "prettier": "^3.6.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2",
    "vite": "^6.3.6"
  }
}
