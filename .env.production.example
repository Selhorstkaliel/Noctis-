PUBLIC_HOST=community.example.com
# Railway Free/Trial/Hobby: use the MailerSend HTTPS API because outbound SMTP is blocked.
MAIL_TRANSPORT=mailersend
MAIL_FROM=security@your-verified-domain.com
MAILERSEND_API_TOKEN=REPLACE_WITH_MAILERSEND_API_TOKEN
SMTP_HOST=smtp.mailersend.net
SMTP_PORT=587
SMTP_USER=REPLACE_WITH_MAILERSEND_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_MAILERSEND_SMTP_PASSWORD
POSTGRES_PASSWORD=REPLACE_WITH_ADMINISTRATOR_PASSWORD
DATABASE_URL=postgresql://noctis_api:REPLACE_WITH_API_PASSWORD@postgres:5432/noctis
AUTH_DATABASE_URL=postgresql://noctis_auth:REPLACE_WITH_AUTH_PASSWORD@postgres:5432/noctis
WORKER_DATABASE_URL=postgresql://noctis_worker:REPLACE_WITH_WORKER_PASSWORD@postgres:5432/noctis
MIGRATION_DATABASE_URL=postgresql://noctis_migrator:REPLACE_WITH_MIGRATOR_PASSWORD@postgres:5432/noctis
# Direct/session connection for LISTEN; never point this at transaction pooling.
LISTENER_DATABASE_URL=postgresql://noctis_api:REPLACE_WITH_API_PASSWORD@postgres:5432/noctis
API_POOL_SIZE=15
AUTH_POOL_SIZE=5
WORKER_POOL_SIZE=5
REALTIME_CONCURRENCY=4
SESSION_SECRET=REPLACE_WITH_64_HEX_CHARACTERS
ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
POSTGRES_CA_FILE=/absolute/path/to/postgres-ca.crt
POSTGRES_CERT_FILE=/absolute/path/to/postgres.crt
POSTGRES_KEY_FILE=/absolute/path/to/postgres.key
LIVEKIT_INTERNAL_URL=http://sfu:7880
LIVEKIT_API_KEY=REPLACE_WITH_RANDOM_API_KEY
LIVEKIT_API_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
MUSIC_AUDIO_HOSTS=
MUSIC_MAX_QUEUE=100
MUSIC_MAX_TRACK_SECONDS=3600
MUSIC_MAX_SOURCE_BYTES=209715200
MUSIC_FETCH_TIMEOUT_MS=10000
MUSIC_IDLE_DISCONNECT_SECONDS=300
FFMPEG_PATH=ffmpeg
MEDIA_PUBLIC_IP=REPLACE_WITH_MEDIA_HOST_PUBLIC_IPV4
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
